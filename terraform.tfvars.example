# Copy this file to terraform.tfvars and adjust values before deploying
# Sensitive values should be passed via environment variables:
#   export TF_VAR_db_password="YourStr0ngP@ssword!"

aws_region  = "us-east-1"
project     = "myapp"
environment = "prod"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
db_subnet_cidrs      = ["10.0.21.0/24", "10.0.22.0/24"]

web_instance_type    = "t3.micro"
web_ami_id           = "ami-0c02fb55956c7d316"
web_min_size         = 2
web_max_size         = 4
web_desired_capacity = 2

app_instance_type    = "t3.small"
app_ami_id           = "ami-0c02fb55956c7d316"
app_min_size         = 2
app_max_size         = 4
app_desired_capacity = 2

db_instance_class    = "db.t3.medium"
db_engine            = "mysql"
db_engine_version    = "8.0"
db_name              = "appdb"
db_username          = "admin"
db_password          = "CHANGE_ME_BEFORE_DEPLOY"
db_allocated_storage = 20
